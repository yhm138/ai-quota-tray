<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and Windows 11, so the
       exe needs no runtime download and stays well under 1 MB. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>QuotaTray</AssemblyName>
    <RootNamespace>QuotaTray</RootNamespace>
    <Version>1.7.0</Version>
    <Product>QuotaTray</Product>
    <Description>Claude, Codex and Antigravity usage in the Windows tray</Description>
    <Copyright>MIT License</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- CI generates the icon with python/tools/make_icon.py first. -->
  <PropertyGroup Condition="Exists('..\..\..\assets\quotatray.ico')">
    <ApplicationIcon>..\..\..\assets\quotatray.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only: lets any machine with the .NET SDK
         (Linux included) compile for .NET Framework 4.8. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
