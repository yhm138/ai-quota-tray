# Normalise to LF in the repository, and check out .bat as CRLF.
# A batch file with LF-only endings misbehaves in cmd.exe, and without this
# the result depends on each contributor's core.autocrlf setting.
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.py    text eol=lf
*.pyw   text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

*.png   binary
*.ico   binary
*.zip   binary
*.exe   binary
